// Ignore me

procedure check-version begin
   version : string = "0.0.1"
end

procedure add with
   a : i32,
   b : i32,
   returns i32
begin
   return a + b
end

procedure main begin
   result : i32 = 50

   while true do
      result -= 1

      if result <= 0 then
         break
      else if true then
         continue
      end
   end

   return result

   add(5, 10)
end

